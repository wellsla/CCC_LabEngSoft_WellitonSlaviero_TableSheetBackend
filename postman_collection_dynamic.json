{
    "info": {
        "name": "TableSheet API - Dynamic Token",
        "description": "API documentation for the TableSheet backend with dynamic token management",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://host.docker.internal",
            "type": "string"
        },
        {
            "key": "authToken",
            "value": "",
            "type": "string"
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{authToken}}",
                "type": "string"
            }
        ]
    },
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Pre-request script to set up authentication",
                    "const authToken = pm.collectionVariables.get('authToken');",
                    "if (authToken) {",
                    "    pm.request.headers.add({",
                    "        key: 'Authorization',",
                    "        value: `Bearer ${authToken}`",
                    "    });",
                    "}"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"john_doe\",\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"password\": \"password123\",\n    \"birth_date\": \"1990-01-01\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "register"
                            ]
                        },
                        "description": "Create a new user account. Email verification is required before login."
                    },
                    "response": []
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// Test script to capture token from login response",
                                    "if (pm.response.code === 200) {",
                                    "    const responseJson = pm.response.json();",
                                    "    if (responseJson.data && responseJson.data.token) {",
                                    "        pm.collectionVariables.set('authToken', responseJson.data.token);",
                                    "        console.log('Token captured and saved:', responseJson.data.token);",
                                    "    }",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"john@example.com\",\n    \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "login"
                            ]
                        },
                        "description": "Authenticate user and return access token. Token will be automatically captured and used for subsequent requests."
                    },
                    "response": []
                },
                {
                    "name": "Logout",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// Clear token on successful logout",
                                    "if (pm.response.code === 200) {",
                                    "    pm.collectionVariables.set('authToken', '');",
                                    "    console.log('Token cleared after logout');",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/logout",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "logout"
                            ]
                        },
                        "description": "Revoke the current access token and logout the user."
                    },
                    "response": []
                },
                {
                    "name": "Get User",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/user",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "user"
                            ]
                        },
                        "description": "Retrieve the currently authenticated user's information."
                    },
                    "response": []
                },
                {
                    "name": "Forgot Password",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"john@example.com\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/forgot-password",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "forgot-password"
                            ]
                        },
                        "description": "Send a password reset link to the user's email address."
                    },
                    "response": []
                },
                {
                    "name": "Reset Password",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"token\": \"reset_token_here\",\n    \"email\": \"john@example.com\",\n    \"password\": \"newpassword123\",\n    \"password_confirmation\": \"newpassword123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/reset-password",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "reset-password"
                            ]
                        },
                        "description": "Reset the user's password using the reset token received via email."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Games",
            "item": [
                {
                    "name": "List Games",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/games?per_page=10&sort=name&direction=asc",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "games"
                            ],
                            "query": [
                                {
                                    "key": "per_page",
                                    "value": "10"
                                },
                                {
                                    "key": "sort",
                                    "value": "name"
                                },
                                {
                                    "key": "direction",
                                    "value": "asc"
                                }
                            ]
                        },
                        "description": "Retrieve a paginated list of active games available in the system."
                    },
                    "response": []
                },
                {
                    "name": "Get Game",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/games/1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "games",
                                "1"
                            ]
                        },
                        "description": "Retrieve detailed information about a specific game."
                    },
                    "response": []
                },
                {
                    "name": "Create Game (Admin)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Pathfinder 2e\",\n    \"description\": \"A fantasy tabletop RPG\",\n    \"version\": \"2.0\",\n    \"cover_image_url\": \"https://example.com/cover.jpg\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/games",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "games"
                            ]
                        },
                        "description": "Create a new game. Requires admin privileges."
                    },
                    "response": []
                }
            ]
        },
